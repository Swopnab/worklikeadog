# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
LOG_LEVEL=INFO

# ============================================================
# DATABASE
# ============================================================
# Path to SQLite database file. Relative to project root.
DATABASE_PATH=./database/application.db

# ============================================================
# OLLAMA
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Max concurrent AI inference requests (start low to avoid overloading Ollama)
OLLAMA_CONCURRENCY=1
# Timeout in seconds for Ollama API calls
OLLAMA_TIMEOUT=120

# ============================================================
# AGENT BEHAVIOR
# ============================================================
# DRY RUN: When true, agent fills applications but NEVER clicks Submit
DRY_RUN=true
# AUTO_SUBMIT: When true, agent may submit if ALL safety checks pass
AUTO_SUBMIT=false
# Minimum match score (0-100) required before applying
MIN_MATCH_SCORE=65
# Maximum applications per day
MAX_APPLICATIONS_PER_DAY=25
# Delay between actions in seconds (rate limiting)
ACTION_DELAY_SECONDS=2

# ============================================================
# BROWSER
# ============================================================
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=500

# ============================================================
# PATHS
# ============================================================
APPLICATIONS_DIR=./applications
RESUME_GENERATED_DIR=./resume/generated
LOGS_DIR=./logs
